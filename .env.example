# =============================================================================
# ResolveAI Production Environment Configuration
# =============================================================================

# =============================================================================
# Database Configuration
# =============================================================================
# Postgres connection string: postgresql://user:password@host:5432/database
# For development, defaults to SQLite: sqlite:///./resolveai.db
DATABASE_URL=postgresql://user:password@localhost:5432/resolveai

# =============================================================================
# JWT Authentication Configuration
# =============================================================================
# Secret key for signing JWT tokens - must be a strong random string
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_AFTER_DEPLOY_64_CHARACTER_STRONG_RANDOM
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# AI Provider Configuration
# =============================================================================
# OpenAI API Key (required for real embeddings and LLM responses)
OPENAI_API_KEY=CHANGE_ME_AFTER_DEPLOY_YOUR_OPENAI_KEY
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.0
AI_MAX_TOKENS=1000
USE_MOCK_AI=false
ANTHROPIC_API_KEY=CHANGE_ME_AFTER_DEPLOY_ANTHROPIC_KEY
ANTHROPIC_MODEL=claude-3-haiku-20240307

# =============================================================================
# File Upload Configuration
# =============================================================================
# Maximum file size in MB for knowledge base uploads
MAX_FILE_SIZE_MB=10

# =============================================================================
# CORS Configuration
# =============================================================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# =============================================================================
# Application Configuration
# =============================================================================
# Rate limiting defaults: 100/minute, 1000/hour
RATE_LIMIT_DEFAULT=100/minute,1000/hour

# Environment mode
ENVIRONMENT=production